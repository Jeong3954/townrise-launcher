{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TownRise Launcher",
  "version": "0.1.7",
  "identifier": "kr.glound.townrise.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "TownRise Launcher",
        "width": 1120,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0M0UyOTAyOEU4N0IwNDMKUldSRHNJZU9BaWsrWkcwMCtLUmdlaWVycVhnTyt3eCt0TUExdzJIbFNCdlZlaWo0QzFvZlk4WVoK",
      "endpoints": [
        "https://github.com/Jeong3954/townrise-launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
